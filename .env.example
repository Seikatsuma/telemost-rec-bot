# ===== Обязательно =====
# Токен бота: Telegram → @BotFather → /newbot
BOT_TOKEN=
# Ключ Deepgram для расшифровки: https://console.deepgram.com — новым аккаунтам дают
# $200 кредита (~700 часов распознавания), карта не нужна. Пусто — расшифровка идёт через Groq.
DEEPGRAM_API_KEY=
# Ключ Groq (бесплатно): https://console.groq.com/keys
# Запасной путь расшифровки при сбое Deepgram + конспект, если нет DeepSeek-ключа.
GROQ_API_KEY=

# ===== Доступ =====
# Telegram id тех, кто может пользоваться ботом, через запятую.
# Пусто — бот закрепится за первым, кто напишет ему /start (это и будет владелец).
OWNER_IDS=
# 1 — пускать всех, кто напишет боту (для открытой проверки знакомыми). /login и /selftest — всё равно только владельцу.
ALLOW_ALL=0
# Ссылка на этот репозиторий — бот предложит её чужому человеку без доступа («поднимите своего»).
# Пусто — чужой получит только просьбу передать свой id владельцу.
PUBLIC_REPO_URL=https://github.com/Seikatsuma/telemost-rec-bot

# ===== Необязательно =====
# Конспект встречи через DeepSeek (если пусто — конспект делает модель Groq): https://platform.deepseek.com
DEEPSEEK_API_KEY=
# Имя бота во встрече (без цифр — Телемост их не принимает)
BOT_NAME=Запись встречи
# 1 — камера бота показывает картинку assets/camera.png («идёт запись»); 0 — камера выключена
BOT_CAMERA=1
# Все вышли — сколько секунд ждать возвращения, прежде чем закончить запись и сказать об этом
GRACE_SEC=30
# Сколько бот сторожит ссылку после последнего участника (5 ч): вернулись — запишет снова,
# позже — ссылка перестаёт записывать, нужна новая встреча
IDLE_LEAVE_SEC=3600          # час сторожения ссылки от её создания (владелец 21.09)
# Сколько дней хранить запись на сервере после отправки в Telegram (0 — всегда)
REC_KEEP_DAYS=30
# Сколько последних ссылок бот держит под наблюдением. Новая вытесняет самую старую,
# на которой сейчас не идёт запись (каждая — отдельный браузер)
MAX_MEETINGS=3
# 1 — держать заготовку встречи: ссылка сразу, бот в звонке за ~6 с (ещё один браузер в памяти)
WARM_ENABLED=1

# ===== Для особых серверов =====
# Ключи отдельным файлом вне папки бота
# EXTRA_ENV_FILE=~/.secrets/telemost-rec-bot.env
# Папка системных библиотек Chromium, если их нельзя поставить через sudo
# BROWSER_SYSLIBS=/path/to/usr/lib/x86_64-linux-gnu
